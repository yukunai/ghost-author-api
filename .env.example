PORT=8787
HOST=127.0.0.1
GHOST_URL=http://localhost:2368
GHOST_ADMIN_API_KEY=
GHOST_API_VERSION=v6.0

# Comma-separated Ghost Members emails allowed to publish from the frontend.
CERTIFIED_AUTHOR_EMAILS=

# Set false if certified authors should only create drafts.
ALLOW_DIRECT_PUBLISH=true

# Max JSON request body. 220mb matches the 9-image / 4-video frontend limits.
REQUEST_BODY_LIMIT=220mb

# Optional CORS origin, for example https://yourdomain.com.
# Leave blank when this API is reverse-proxied under the same Ghost domain.
CORS_ORIGIN=

# Optional. Only enable when the API is behind a trusted reverse proxy.
# TRUST_PROXY=true

# Optional Google OAuth login. Leave blank until the OAuth client is created.
# Google Console redirect URI:
# https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback
AUTH_COOKIE_SECRET=
AUTH_SUCCESS_REDIRECT=/
AUTH_FAILURE_REDIRECT=/?auth=failed
# AUTH_COOKIE_DOMAIN=yourdomain.com
# AUTH_COOKIE_SECURE=true
